# Kopieren nach .env und ausfüllen. .env wird NIE committet (siehe .gitignore).

# eBuSy-Zugangsdaten für bsbb.ebusy.de
EBUSY_BASE_URL=https://bsbb.ebusy.de
EBUSY_USERNAME=
EBUSY_PASSWORD=

# Optional: E-Mail-Ziel für Erfolg/Misserfolg-Benachrichtigungen
# (nur genutzt, wenn notification.email_enabled: true in config.yaml)
NOTIFY_EMAIL_TO=

# Optional: SMTP-Zugangsdaten für den Versand obiger Benachrichtigung.
# Funktioniert kostenlos mit einem bestehenden Mail-Account, z.B. GMX
# (smtp.gmx.net, Port 587) oder Gmail (smtp.gmail.com, Port 587, App-Passwort
# statt normalem Passwort verwenden).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Zugangsdaten fuer die Web-Oberflaeche (main.py serve-ui), zum Anpassen des
# Ziel-Slots per Browser statt SSH. Waehle ein eigenes, starkes Passwort -
# NICHT dein eBuSy-Passwort wiederverwenden. Die Oberflaeche laeuft ohne
# eigenes HTTPS (nur per Basic-Auth abgesichert), zeigt aber nirgends deine
# eBuSy-Zugangsdaten an - nur Wochentag/Uhrzeit/Suchfenster etc.
UI_USERNAME=
UI_PASSWORD=
